{
  "name": "quiz-web-app",
  "version": "1.0.0",
  "description": "A quiz web application with timer, scoring, and leaderboard",
  "type": "module",
  "scripts": {
    "start": "npx serve . -l 3000",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"tests/**/*.js\" \"*.html\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.0",
    "serve": "^14.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {}
  }
}
